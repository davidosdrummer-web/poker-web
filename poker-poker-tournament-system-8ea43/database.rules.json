{
  "rules": {
    "users": {
      "$uid": {
        // Пользователь может читать и писать свои данные
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "role": {
          // Роль может читать любой авторизованный пользователь
          ".read": "auth != null",
          // Только админ может менять роли
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },
    "players_index": {
      // Любой авторизованный пользователь может читать список игроков
      ".read": "auth != null",
      ".write": "auth != null",
      "$playerId": {
        // Игрок может читать свой профиль
        ".read": "auth != null",
        // Игрок может создавать/обновлять свой профиль при регистрации
        ".write": "auth != null && (auth.uid === $playerId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".indexOn": ["status"]
      }
    },
    "games": {
      // Читать игры могут все авторизованные
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "tournaments": {
      // Читать турниры могут все авторизованные
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
